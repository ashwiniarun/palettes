{
  "expo": {
    "name": "Palettes",
    "slug": "palettes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "facetags",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Palettes uses your camera to scan product barcodes so you can add them to your closet faster."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Palettes uses your photo library so you can post a look.",
          "cameraPermission": "Palettes uses your camera so you can take a photo for a look."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
